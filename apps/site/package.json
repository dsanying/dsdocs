{
  "name": "@dsdocs/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "init": "tsx scripts/init.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "export:files": "tsx scripts/export-files.ts"
  },
  "dependencies": {
    "@fumadocs/mdx-remote": "1.5.2",
    "fflate": "0.8.3",
    "fumadocs-core": "16.17.3",
    "fumadocs-ui": "16.17.3",
    "katex": "0.18.2",
    "lucide-react": "0.468.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.0",
    "typescript": "6.0.3"
  },
