{
  "name": "@dsdocs/manage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env server/start.mjs",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "build:ui": "node scripts/run-runtime.mjs build-ui",
    "check": "node scripts/run-checks.mjs",
    "check:affected": "node scripts/run-checks.mjs --affected",
    "check:staged": "node scripts/run-checks.mjs --staged",
    "check:build": "node scripts/run-checks.mjs --phase build",
    "check:ui": "node scripts/run-checks.mjs --phase ui",
    "lint": "node scripts/run-checks.mjs --phase static",
    "lint:design": "node scripts/test-design.mjs && node --test scripts/manifest-governance.test.mjs scripts/navigation-governance.test.mjs scripts/transport-governance.test.mjs scripts/component-catalog.test.mjs scripts/run-checks.test.mjs scripts/report-structure.test.mjs && node scripts/check-design.mjs && node scripts/component-selection.mjs --check",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:i18n": "node --test ./scripts/i18n-governance.test.mjs ./scripts/i18n-compose.test.mjs ./scripts/i18n-rewrite-keys.test.mjs && node ./scripts/i18n-lint.mjs",
    "lint:dependency-builds": "node ./scripts/check-ignored-builds.mjs && node scripts/check-runtime-patches.mjs",
    "i18n:prune": "node ./scripts/i18n-lint.mjs --prune-unused",
    "i18n:compose": "node ./scripts/i18n-compose.mjs --write",
    "i18n:promote": "node ./scripts/i18n-promote-vocab.mjs",
    "i18n:duplicates": "node ./scripts/i18n-lint.mjs --report-duplicates",
    "preview": "vite preview",
    "report:structure": "node scripts/report-structure.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:ui": "pnpm build:ui && node scripts/run-runtime.mjs ui-full && node scripts/run-runtime.mjs ui-dev-forms",
    "test:ui:full": "pnpm build:ui && node scripts/run-runtime.mjs ui-full && node scripts/run-runtime.mjs ui-dev-forms",
    "typecheck": "tsc -b --pretty false",
    "check:static": "node scripts/run-checks.mjs --phase static",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=../../.env server/start.mjs",
    "check:ci": "node scripts/run-checks.mjs --ci"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@mdxeditor/editor": "4.3.3",
    "@monaco-editor/react": "4.7.0",
    "@react-querybuilder/antd": "8.24.3",
    "antd": "6.6.5",
    "axios": "1.20.0",
    "better-auth": "1.7.9",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.10.1",
    "cronstrue": "3.27.0",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "httpxy": "0.5.5",
    "i18next": "26.4.2",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-querybuilder": "8.24.3",
    "react-router": "8.4.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.3",
    "zustand": "5.0.15",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "@dsanying/dsdocs": "file:../../packages/react"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "postcss": "8.5.28",
    "typescript-eslint": "8.71.0"
  }
}
