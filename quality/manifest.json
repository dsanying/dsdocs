{
  "gates": [
    {
      "id": "project-contract",
      "rule": "docs/维护手册.md",
      "command": [
        "node",
        "scripts/check-project.mjs"
      ]
    },
    {
      "id": "management-complete",
      "rule": "docs/规范/前端/08-门禁.md",
      "command": [
        "node",
        "scripts/check-management.mjs"
      ]
    },
    {
      "id": "reader-component-contract",
      "rule": "docs/规范/读者端.md",
      "command": [
        "node",
        "scripts/check-reader-contract.mjs"
      ]
    },
    {
      "id": "format",
      "rule": "docs/规范/前端.md",
      "command": [
        "pnpm",
        "-C",
        "apps/manage",
        "exec",
        "prettier",
        "--check",
        "src",
        "server",
        "tests",
        "vite.config.ts",
        "tsconfig.json",
        "package.json",
        "../reader/src",
        "../../packages",
        "starter"
      ]
    },
    {
      "id": "backup-regression",
      "rule": "docs/规范/后端.md",
      "command": [
        "node",
        "--test",
        "scripts/tests/backup.test.mjs"
      ]
    },
    {
      "id": "license-output-regression",
      "rule": "THIRD_PARTY_NOTICES.md",
      "command": [
        "node",
        "--test",
        "scripts/tests/licenses.test.mjs"
      ]
    },
    {
      "id": "starter-regression",
      "rule": "docs/设计/初始内容.md",
      "command": [
        "node",
        "--test",
        "scripts/tests/starter.test.mjs"
      ]
    },
    {
      "id": "service-regression",
      "rule": "docs/规范/后端.md",
      "command": [
        "node",
        "--test",
        "apps/manage/tests/system.test.mjs"
      ]
    },
    {
      "id": "files-settings-regression",
      "rule": "docs/设计/文件与站点设置.md",
      "command": [
        "node",
        "--test",
        "apps/manage/tests/files.test.mjs"
      ]
    },
    {
      "id": "reader-types",
      "rule": "docs/规范/前端.md",
      "command": [
        "pnpm",
        "-C",
        "apps/reader",
        "typecheck"
      ]
    },
    {
      "id": "reader-build",
      "rule": "docs/规范/前端.md",
      "command": [
        "pnpm",
        "-C",
        "apps/reader",
        "build"
      ]
    },
    {
      "id": "dependency-notices",
      "rule": "THIRD_PARTY_NOTICES.md",
      "command": [
        "node",
        "scripts/notices.mjs"
      ]
    },
    {
      "id": "business-browser",
      "localOnly": true,
      "rule": "docs/设计/管理端接入.md",
      "command": [
        "node",
        "scripts/check-business-browser.mjs"
      ]
    }
  ]
}
