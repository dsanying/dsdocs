# Set these in the process environment. The application does not load this file automatically.
DSDOCS_BASE_PATH=/docs
DSDOCS_ORIGIN=http://localhost:3200
DSDOCS_DATABASE=/absolute/path/to/dsdocs.sqlite
DSDOCS_TITLE=dsdocs
# Supply only for the one-time db:init command. No default password is provided.
DSDOCS_ADMIN_USERNAME=
DSDOCS_ADMIN_PASSWORD=
