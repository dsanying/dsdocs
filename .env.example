# 本地管理入口；实际部署时设置为管理域名的完整 origin。
DSDOCS_URL=http://127.0.0.1:5182
DSDOCS_AUTH=local
# 全新内容数据库默认载入教程；设为 none 则从空站点开始。
DSDOCS_STARTER=guide
# Compose 管理入口的 origin。
DSDOCS_MANAGEMENT_URL=http://127.0.0.1:5182
# 可选：管理端和读者端共用的绝对内容目录。留注释则使用用户目录默认值。
# DSDOCS_DATA_DIR=/absolute/path/to/dsdocs-data
# 可选：独立 Git 备份仓库；默认不推送。
# DSDOCS_GIT_BACKUP_DIR=/absolute/path/to/backup-repository
# DSDOCS_GIT_PUSH=1
